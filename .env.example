# ==============================================================================
# Environment Variables Template (.env.example)
# Safe for version control - do not place real production credentials here.
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000

# Backend API Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME="Smart Inventory Management & Demand Forecasting"

# Security & Secrets (Generate 64-char hex key for JWT and 32-byte Base64 key for ENCRYPTION_KEY in production)
# Example generator: python scripts/generate_secrets.py
JWT_SECRET_KEY=change-this-to-a-super-secret-random-32-byte-hex-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENCRYPTION_KEY=dGVzdF9lbmNyeXB0aW9uX2tleV9mb3JfZGV2XzMyYnl0ZXM=

# Webhook Secrets
SHOPIFY_WEBHOOK_SECRET=dev_shopify_webhook_secret_key
SQUARE_WEBHOOK_SECRET=dev_square_webhook_secret_key

# PostgreSQL Database (Local or Render / Neon / Supabase Cloud Database)
# Note: postgres:// and postgresql:// prefixes are automatically converted to postgresql+asyncpg://
# Render External / Neon example: postgresql+asyncpg://user:password@host/dbname?ssl=require
# Render Internal example: postgresql+asyncpg://user:password@dpg-xxx-a/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smart_inventory

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379/0

# CORS Configuration (comma-separated origins permitted to make browser requests)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend-domain.onrender.com

# Frontend Public API URL (Used by Next.js client)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
