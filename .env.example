# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME="Smart Inventory Management & Demand Forecasting"

# Security & Secrets (Replace with high-entropy keys in production)
JWT_SECRET_KEY=change-this-to-a-super-secret-random-32-byte-hex-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENCRYPTION_KEY=dGVzdF9lbmNyeXB0aW9uX2tleV9mb3JfZGV2XzMyYnl0ZXM=

# Webhook Secrets
SHOPIFY_WEBHOOK_SECRET=dev_shopify_webhook_secret_key
SQUARE_WEBHOOK_SECRET=dev_square_webhook_secret_key

# Database (PostgreSQL 15+)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smart_inventory
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smart_inventory_test

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379/0

# CORS Configuration (comma-separated URLs)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Next.js Public Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
