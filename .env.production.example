# ==============================================================================
# Production Environment Variables Template (.env.production)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.production on your production server.
# 2. Generate cryptographically strong random secrets for all empty values below.
# 3. DO NOT commit .env.production into git version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=production
LOG_LEVEL=INFO
PROJECT_NAME="Smart Inventory Management & Demand Forecasting"
API_V1_PREFIX=/api/v1
WEB_CONCURRENCY=4

# ------------------------------------------------------------------------------
# Security & Cryptographic Secrets
# ------------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX_KEY_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Generate with: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY_IN_PRODUCTION

# ------------------------------------------------------------------------------
# Webhook Secrets
# ------------------------------------------------------------------------------
SHOPIFY_WEBHOOK_SECRET=REPLACE_WITH_SHOPIFY_PARTNER_APP_SHARED_SECRET
SQUARE_WEBHOOK_SECRET=REPLACE_WITH_SQUARE_WEBHOOK_SIGNATURE_KEY

# ------------------------------------------------------------------------------
# PostgreSQL 15+ Database
# ------------------------------------------------------------------------------
POSTGRES_USER=smart_inv_admin
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_POSTGRES_PASSWORD
POSTGRES_DB=smart_inventory_prod

# Full connection string used by FastAPI (automatically constructed in docker-compose.prod.yml):
# DATABASE_URL=postgresql+asyncpg://smart_inv_admin:PASSWORD@postgres:5432/smart_inventory_prod

# ------------------------------------------------------------------------------
# Redis 7+ Cache & Queue
# ------------------------------------------------------------------------------
REDIS_PASSWORD=REPLACE_WITH_STRONG_RANDOM_REDIS_PASSWORD
# REDIS_URL=redis://:PASSWORD@redis:6379/0

# ------------------------------------------------------------------------------
# Domains & CORS Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of fully qualified production domain origins:
ALLOWED_ORIGINS=https://app.yourdomain.com,https://api.yourdomain.com

# Frontend public API routing:
NEXT_PUBLIC_API_URL=/api/v1
